<?xml version="1.0" encoding="utf-8"?>
<!-- Publicação para o IIS (10.0.30.97): copiar o conteúdo de PublishUrl para C:\AppTIC\site no servidor. -->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishUrl>bin\Release\net10.0\publish-iis\</PublishUrl>
    <!-- dotnet publish (CLI) usa PublishDir; o Visual Studio usa PublishUrl. -->
    <PublishDir>$(PublishUrl)</PublishDir>
    <Configuration>Release</Configuration>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <!-- Os feeds GTFS locais (App_Data) não vão para o servidor. -->
    <ExcludeApp_Data>true</ExcludeApp_Data>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
  </PropertyGroup>
</Project>
