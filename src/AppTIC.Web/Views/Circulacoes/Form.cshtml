@model Circulacao
@{
    ViewData["Title"] = Model.Id == 0 ? "Nova circulação" : $"Editar circulação {Model.ViagemId}";
    var operadores = (List<LookupItem>)ViewBag.Operadores;
    var paragens = (List<LookupItem>)ViewBag.Paragens;
    var ambitos = (List<LookupItem>)ViewBag.Ambitos;
    var categorias = (List<LookupItem>)ViewBag.Categorias;
    var temHistorico = (bool)ViewBag.TemHistoricoTic;
    DateTime? Hora(TimeOnly? t) => t is null ? null : DateTime.Today.Add(t.Value.ToTimeSpan());
}
<div class="page-header"><h1>@ViewData["Title"]</h1></div>

@if (operadores.Count == 0)
{
    <div class="alert alert-warning">Ainda não tem operadores. <a asp-controller="Operadores" asp-action="Create">Crie um operador</a> antes de registar circulações.</div>
}

<form asp-action="Save" method="post" class="card card-form">
    <div class="card-body">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <h2 class="h6 text-uppercase text-muted">Serviço</h2>
        <div class="row g-3 mb-4">
            <div class="col-md-5">
                <label asp-for="OperadorId" class="form-label"></label>
                <ejs-dropdownlist id="OperadorId" name="OperadorId" dataSource="@operadores" value="@(Model.OperadorId == 0 ? null : Model.OperadorId.ToString())"
                                  placeholder="Escolha o operador…" allowFiltering="true" filterType="Contains">
                    <e-dropdownlist-fields text="Text" value="Value"></e-dropdownlist-fields>
                </ejs-dropdownlist>
                <span asp-validation-for="OperadorId" class="text-danger small"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="LinhaId" class="form-label"></label>
                <input asp-for="LinhaId" class="form-control" />
            </div>
            <div class="col-md-5">
                <label asp-for="DesignacaoLinha" class="form-label"></label>
                <input asp-for="DesignacaoLinha" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="Ambito" class="form-label"></label>
                <ejs-dropdownlist id="Ambito" name="Ambito" dataSource="@ambitos" value="@Model.Ambito?.ToString()" placeholder="Escolha…" showClearButton="true">
                    <e-dropdownlist-fields text="Text" value="Value"></e-dropdownlist-fields>
                </ejs-dropdownlist>
            </div>
            <div class="col-md-3">
                <label asp-for="Categoria" class="form-label"></label>
                <ejs-dropdownlist id="Categoria" name="Categoria" dataSource="@categorias" value="@Model.Categoria?.ToString()" placeholder="Escolha…" showClearButton="true">
                    <e-dropdownlist-fields text="Text" value="Value"></e-dropdownlist-fields>
                </ejs-dropdownlist>
            </div>
            <div class="col-md-3">
                <label asp-for="Autorizacao" class="form-label"></label>
                <input asp-for="Autorizacao" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="AutorizacaoValidade" class="form-label"></label>
                <ejs-datepicker id="AutorizacaoValidade" name="AutorizacaoValidade" value="@Model.AutorizacaoValidade.ToDateTime()" format="dd/MM/yyyy" placeholder="dd/mm/aaaa"></ejs-datepicker>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <ejs-checkbox id="DeclaracaoCapacidade" name="DeclaracaoCapacidade" value="true" checked="@Model.DeclaracaoCapacidade" label="Precisa de declaração de capacidade"></ejs-checkbox>
                <input type="hidden" name="DeclaracaoCapacidade" value="false" />
            </div>
            <div class="col-md-3">
                <label asp-for="IdDcp" class="form-label"></label>
                <input asp-for="IdDcp" class="form-control" />
            </div>
        </div>

        <h2 class="h6 text-uppercase text-muted">Viagem no TIC</h2>
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <label asp-for="ViagemId" class="form-label"></label>
                <input asp-for="ViagemId" class="form-control" />
                <span asp-validation-for="ViagemId" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="IdTic" class="form-label"></label>
                <input asp-for="IdTic" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="OrigemId" class="form-label"></label>
                <ejs-dropdownlist id="OrigemId" name="OrigemId" dataSource="@paragens" value="@Model.OrigemId?.ToString()"
                                  placeholder="Escolha a paragem…" allowFiltering="true" filterType="Contains" showClearButton="true">
                    <e-dropdownlist-fields text="Text" value="Value"></e-dropdownlist-fields>
                </ejs-dropdownlist>
                <span asp-validation-for="OrigemId" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="DestinoId" class="form-label"></label>
                <ejs-dropdownlist id="DestinoId" name="DestinoId" dataSource="@paragens" value="@Model.DestinoId?.ToString()"
                                  placeholder="Escolha a paragem…" allowFiltering="true" filterType="Contains" showClearButton="true">
                    <e-dropdownlist-fields text="Text" value="Value"></e-dropdownlist-fields>
                </ejs-dropdownlist>
                <span asp-validation-for="DestinoId" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Chegada" class="form-label"></label>
                <ejs-timepicker id="Chegada" name="Chegada" value="@Hora(Model.Chegada)" enabled="@(!temHistorico)" format="HH:mm" step="5" placeholder="hh:mm"></ejs-timepicker>
            </div>
            <div class="col-md-3">
                <label asp-for="Partida" class="form-label"></label>
                <ejs-timepicker id="Partida" name="Partida" value="@Hora(Model.Partida)" enabled="@(!temHistorico)" format="HH:mm" step="5" placeholder="hh:mm"></ejs-timepicker>
                <span asp-validation-for="Partida" class="text-danger small"></span>
                @if (temHistorico) { <div class="form-text">Com histórico: altere as horas no detalhe da circulação, por período.</div> }
            </div>
            <div class="col-md-6">
                <label asp-for="TempoEmbarqueMinutos" class="form-label"></label>
                <input asp-for="TempoEmbarqueMinutos" class="form-control" type="number" min="0" max="1440" />
                <div class="form-text">Tempo antes da partida ou depois da chegada para embarque/desembarque, caso o TIC seja início ou fim de viagem.</div>
            </div>
            <div class="col-12">
                <label asp-for="Comentarios" class="form-label"></label>
                <textarea asp-for="Comentarios" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
