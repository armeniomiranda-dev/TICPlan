@model List<GrupoRow>
@{
    ViewData["Title"] = "Grupos de operadores";
    var promover = (List<LookupItem>)ViewBag.Promover;
}
<div class="page-header">
    <h1>Grupos de operadores</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Novo grupo</a>
</div>

<p class="small text-muted">Um grupo (ex.: Rede Nacional de Expressos) junta vários operadores. Os utilizadores associados ao grupo veem e fazem
    pedidos para todos os operadores do grupo; nos operadores do grupo vale o prefixo do ID TIC do grupo.</p>

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-sm align-middle small mb-0">
            <thead><tr><th>Grupo</th><th>NIF</th><th>ID TIC</th><th>Operadores do grupo</th><th class="text-end">Circulações</th><th class="text-end">Utilizadores</th><th></th></tr></thead>
            <tbody>
                @foreach (var g in Model)
                {
                    <tr>
                        <td><span class="d-inline-block rounded-circle border align-middle me-1" style="width:12px;height:12px;background:@g.Cor"></span><a asp-action="Edit" asp-route-id="@g.Id" class="fw-semibold">@(g.Abreviatura ?? g.Designacao)</a>
                            @if (g.Abreviatura is not null) { <div class="text-muted">@g.Designacao</div> }</td>
                        <td>@(g.Nif ?? "–")</td>
                        <td class="font-monospace">@(g.NumeracaoIdTic ?? "–")</td>
                        <td><span class="badge text-bg-secondary">@g.NumMembros</span> @g.Membros</td>
                        <td class="text-end">@g.NumCirculacoes</td>
                        <td class="text-end">@g.NumUtilizadores</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@g.Id" title="Editar"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@g.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Desfazer este grupo? Os operadores saem do grupo.')">
                                <button class="btn btn-sm btn-outline-danger" title="Desfazer grupo"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="7" class="text-muted">Ainda não há grupos.</td></tr> }
            </tbody>
        </table>
    </div>
</div>

<form asp-action="Promover" method="post" class="card" style="max-width: 640px">
    <div class="card-header">Transformar um operador existente em grupo</div>
    <div class="card-body">
        <p class="small text-muted mb-2">Para um operador que também representa o grupo (ex.: a RNE, que tem circulações próprias).</p>
        <ejs-dropdownlist id="operadorId" name="operadorId" dataSource="@promover" placeholder="Escolha o operador…" allowFiltering="true" filterType="Contains">
            <e-dropdownlist-fields text="Text" value="Value"></e-dropdownlist-fields>
        </ejs-dropdownlist>
    </div>
    <div class="card-footer"><button class="btn btn-sm btn-outline-primary"><i class="bi bi-diagram-3"></i> Passar a grupo</button></div>
</form>
