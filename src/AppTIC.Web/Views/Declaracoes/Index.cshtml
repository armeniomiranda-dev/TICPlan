@model List<DeclaracaoRow>
@{
    ViewData["Title"] = "Declarações (DCP)";
    var isAdmin = User.IsInRole(Roles.Admin);
    var anos = (List<int>)ViewBag.Anos;
    var ano = (int)ViewBag.Ano;
    var vista = (string)ViewBag.Vista;
    var semDeclaracao = (int)ViewBag.SemDeclaracao;
    var operadores = ViewBag.Operadores as List<LookupItem> ?? [];
    var porRenovar = ViewBag.PorRenovar as int? ?? 0;
    var renovadas = ViewBag.Renovadas as int? ?? 0;
    var circulacoes = ViewBag.Circulacoes as List<DeclaracaoAnoCirculacaoRow> ?? [];
    var anoAtual = (int)ViewBag.AnoAtual;
    // Só o ano em vigor (o mais recente) se gere: anos anteriores ficam para consulta.
    var emVigor = ano == anoAtual;
}
<div class="page-header">
    <h1>Declarações (DCP) <span class="text-primary">@ano</span>
        @if (emVigor) { <span class="badge text-bg-success fs-6 align-middle">em vigor</span> } else { <span class="badge text-bg-secondary fs-6 align-middle">encerrado</span> }</h1>
    <form method="get" class="d-flex gap-2 align-items-center">
        <input type="hidden" name="vista" value="@vista" />
        <label class="small text-muted" for="ano">Ano</label>
        <select id="ano" name="ano" class="form-select form-select-sm" style="width: auto" onchange="this.form.submit()">
            @foreach (var a in anos) { <option value="@a" selected="@(a == ano)">@a</option> }
        </select>
    </form>
</div>

@* A explicação da numeração e a gestão são só para o Admin; o operador vê apenas as declarações. *@
@if (isAdmin)
{
<div class="row g-3 mb-3">
    <div class="col-lg-@(emVigor ? "4" : "12")">
        <div class="card h-100">
            <div class="card-body small">
                <p class="mb-1"><strong>Ano.Número.Versão</strong> — ex.: <code>2026.62.01</code>. As declarações são anuais: a numeração recomeça em cada ano.</p>
                <ul class="mb-0">
                    <li>Cada <strong>nova circulação</strong> recebe uma nova declaração: o número seguinte no ano, versão <code>00</code>.</li>
                    <li>A <strong>versão</strong> sobe quando muda o horário de pelo menos uma circulação da declaração.</li>
                    <li>A <strong>renovação</strong> faz-se sempre do ano mais recente para o seguinte (@anoAtual → @(anoAtual + 1)); as declarações do ano renovado ficam só para consulta.</li>
                </ul>
                @if (semDeclaracao > 0)
                {
                    <p class="mt-2 mb-0 text-warning-emphasis"><i class="bi bi-exclamation-triangle"></i> @semDeclaracao circulação(ões) sem declaração.</p>
                }
            </div>
        </div>
    </div>
    @if (isAdmin && emVigor)
    {
        <div class="col-lg-4">
            <form asp-action="Criar" method="post" class="card h-100">
                <div class="card-header">Nova declaração</div>
                <div class="card-body">
                    <label class="form-label small mb-0" for="operadorId">Operador declarante</label>
                    <ejs-dropdownlist id="operadorId" name="operadorId" dataSource="@operadores" placeholder="Escolha…" allowFiltering="true" filterType="Contains">
                        <e-dropdownlist-fields text="Text" value="Value"></e-dropdownlist-fields>
                    </ejs-dropdownlist>
                    <label class="form-label small mb-0 mt-2" for="circulacoes">Circulações (opcional)</label>
                    <textarea id="circulacoes" name="circulacoes" class="form-control form-control-sm font-monospace" rows="2" placeholder="ID TIC ou ID de viagem, separados por vírgula"></textarea>
                    <div class="form-text">Fica com o número seguinte de @ano, versão 00.</div>
                </div>
                <div class="card-footer"><button class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> Criar</button></div>
            </form>
        </div>
        <div class="col-lg-4">
            <form asp-action="Renovar" method="post" class="card h-100"
                  onsubmit="return confirm('Renovar as @porRenovar declaração(ões) de @ano para @(ano + 1)? As circulações passam para as novas declarações.')">
                <div class="card-header"><i class="bi bi-arrow-repeat"></i> Renovar para @(ano + 1)</div>
                <div class="card-body small">
                    <input type="hidden" name="ano" value="@ano" />
                    <p class="mb-2">@porRenovar declaração(ões) de @ano com circulações por renovar@(renovadas > 0 ? $"; {renovadas} já renovada(s)" : "").</p>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="manterNumeros" value="false" id="renumerar" checked />
                        <label class="form-check-label" for="renumerar">Numeração nova em @(ano + 1) (1, 2, 3…)</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="manterNumeros" value="true" id="manter" />
                        <label class="form-check-label" for="manter">Manter os números (@ano.62 → @(ano + 1).62)</label>
                    </div>
                    <div class="form-text">Cada renovação fica na versão 00 e aponta para a declaração de @ano.</div>
                </div>
                <div class="card-footer"><button class="btn btn-sm btn-outline-primary" disabled="@(porRenovar == 0)"><i class="bi bi-arrow-repeat"></i> Renovar</button></div>
            </form>
        </div>
    }
</div>
}

<ul class="nav nav-tabs mb-0">
    <li class="nav-item"><a class="nav-link @(vista == "declaracoes" ? "active" : "")" asp-route-ano="@ano">Declarações <span class="badge text-bg-secondary">@Model.Count</span></a></li>
    <li class="nav-item"><a class="nav-link @(vista == "circulacoes" ? "active" : "")" asp-route-ano="@ano" asp-route-vista="circulacoes">Por circulação</a></li>
</ul>

<script id="dcpTemplate" type="text/x-template">
    <a href="@Url.Action("Details")/${Id}" class="fw-semibold font-monospace">${Codigo}</a>
</script>
<script id="dcpCircTemplate" type="text/x-template">
    <a href="@Url.Action("Details")/${DeclaracaoId}" class="fw-semibold font-monospace">${Codigo}</a>
</script>
<script>
    // Exporta para Excel com o nome do ano (DCP_2026.xlsx / DCP_2026_circulacoes.xlsx).
    function dcpExportar(args) {
        if (args.item.id.endsWith('_excelexport'))
            this.excelExport({ fileName: '@($"DCP_{ano}{(vista == "circulacoes" ? "_circulacoes" : "")}.xlsx")' });
    }
</script>

@if (vista == "circulacoes")
{
    <ejs-grid id="grid" dataSource="@circulacoes" allowPaging="true" allowSorting="true" allowFiltering="true" allowExcelExport="true"
              allowResizing="true" toolbar="@(new List<string> { "Search", "ExcelExport" })" toolbarClick="dcpExportar">
        <e-grid-filtersettings type="Excel"></e-grid-filtersettings>
        <e-grid-pagesettings pageSize="50"></e-grid-pagesettings>
        <e-grid-columns>
            <e-grid-column field="Codigo" headerText="Declaração" template="#dcpCircTemplate" width="130"></e-grid-column>
            <e-grid-column field="Estado" headerText="Estado" width="170"></e-grid-column>
            <e-grid-column field="Declarante" headerText="Declarante" width="150"></e-grid-column>
            <e-grid-column field="IdTic" headerText="ID TIC" width="90"></e-grid-column>
            <e-grid-column field="ViagemId" headerText="ID de viagem" width="140"></e-grid-column>
            <e-grid-column field="Operador" headerText="Operador" width="150"></e-grid-column>
            <e-grid-column field="LinhaId" headerText="Linha" width="90"></e-grid-column>
            <e-grid-column field="DesignacaoLinha" headerText="Designação da linha" width="220"></e-grid-column>
            <e-grid-column field="Origem" headerText="Origem" width="160"></e-grid-column>
            <e-grid-column field="Destino" headerText="Destino" width="160"></e-grid-column>
            <e-grid-column field="Chegada" headerText="Chegada" width="90"></e-grid-column>
            <e-grid-column field="Partida" headerText="Partida" width="90"></e-grid-column>
            <e-grid-column field="Primeiro" headerText="Primeiro dia" type="date" format="dd/MM/yyyy" width="120"></e-grid-column>
            <e-grid-column field="Ultimo" headerText="Último dia" type="date" format="dd/MM/yyyy" width="120"></e-grid-column>
        </e-grid-columns>
    </ejs-grid>
}
else
{
    <ejs-grid id="grid" dataSource="@Model" allowPaging="true" allowSorting="true" allowFiltering="true" allowExcelExport="true"
              allowResizing="true" toolbar="@(new List<string> { "Search", "ExcelExport" })" toolbarClick="dcpExportar">
        <e-grid-filtersettings type="Excel"></e-grid-filtersettings>
        <e-grid-pagesettings pageSize="50"></e-grid-pagesettings>
        <e-grid-columns>
            <e-grid-column field="Codigo" headerText="Declaração" template="#dcpTemplate" width="130"></e-grid-column>
            <e-grid-column field="Numero" headerText="Número" textAlign="Right" width="90"></e-grid-column>
            <e-grid-column field="Versao" headerText="Versão" textAlign="Right" width="90"></e-grid-column>
            <e-grid-column field="Estado" headerText="Estado" width="180"></e-grid-column>
            <e-grid-column field="Anterior" headerText="Renovação de" width="130"></e-grid-column>
            <e-grid-column field="Declarante" headerText="Declarante" width="160"></e-grid-column>
            <e-grid-column field="Operadores" headerText="Operadores das circulações" width="240"></e-grid-column>
            <e-grid-column field="NumCirculacoes" headerText="Circulações" textAlign="Right" width="110"></e-grid-column>
            <e-grid-column field="AtualizadoEm" headerText="Atualizada em" type="datetime" format="dd/MM/yyyy HH:mm" width="140"></e-grid-column>
        </e-grid-columns>
    </ejs-grid>
}
