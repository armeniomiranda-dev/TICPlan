@model AlterarPasswordViewModel
@{ ViewData["Title"] = "Alterar palavra-passe"; }
<div class="page-header"><h1>Alterar palavra-passe</h1></div>
<form asp-action="AlterarPassword" method="post" class="card card-form" style="max-width: 480px">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3"><label asp-for="Atual" class="form-label"></label><input asp-for="Atual" class="form-control" autocomplete="current-password" /></div>
        <div class="mb-3"><label asp-for="Nova" class="form-label"></label><input asp-for="Nova" class="form-control" autocomplete="new-password" /></div>
        <div class="mb-3"><label asp-for="Confirmar" class="form-label"></label><input asp-for="Confirmar" class="form-control" autocomplete="new-password" /></div>
    </div>
    <div class="card-footer"><button type="submit" class="btn btn-primary">Guardar</button></div>
</form>
