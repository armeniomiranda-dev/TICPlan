@model List<RegistoRow>
@{ var showOwner = (bool?)ViewData["ShowOwner"] ?? false; }
<script id="nivelTemplate" type="text/x-template"><span class="nivel-${Nivel}">${Nivel}</span></script>
<ejs-grid id="gridRegistos" dataSource="@Model" allowPaging="true" allowSorting="true" allowFiltering="true" allowExcelExport="true"
          allowTextWrap="true" toolbar="@(new List<string> { "Search", "ExcelExport" })" toolbarClick="appTic.gridToolbarClick">
    <e-grid-filtersettings type="Excel"></e-grid-filtersettings>
    <e-grid-pagesettings pageSize="25"></e-grid-pagesettings>
    <e-grid-columns>
        <e-grid-column field="Data" headerText="Data" type="datetime" format="dd/MM/yyyy HH:mm:ss" width="150"></e-grid-column>
        <e-grid-column field="Nivel" headerText="Nível" template="#nivelTemplate" width="80"></e-grid-column>
        <e-grid-column field="Categoria" headerText="Categoria" width="110"></e-grid-column>
        <e-grid-column field="Acao" headerText="Ação" width="140"></e-grid-column>
        <e-grid-column field="Mensagem" headerText="Mensagem" width="420"></e-grid-column>
        <e-grid-column field="UserName" headerText="Por" width="170"></e-grid-column>
        <e-grid-column field="Dono" headerText="Login (dono)" visible="@showOwner" width="170"></e-grid-column>
    </e-grid-columns>
</ejs-grid>
