@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var sfVersion = Config["Syncfusion:Version"];
    var isAdmin = User.IsInRole(Roles.Admin);
    string Active(string controller) =>
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] · AppTIC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.syncfusion.com/ej2/@sfVersion/bootstrap5.3.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.syncfusion.com/ej2/@sfVersion/dist/ej2.min.js"></script>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index"><i class="bi bi-signpost-split"></i> AppTIC</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Menu">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="nav-link @Active("Operadores")" asp-controller="Operadores" asp-action="Index"><i class="bi bi-building"></i> Operadores</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Paragens")" asp-controller="Paragens" asp-action="Index"><i class="bi bi-geo-alt"></i> Paragens</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Circulacoes")" asp-controller="Circulacoes" asp-action="Index"><i class="bi bi-bus-front"></i> Circulações</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Calendario")" asp-controller="Calendario" asp-action="Index"><i class="bi bi-calendar3"></i> Calendário</a></li>
                            <li class="nav-item"><a class="nav-link @Active("GtfsFeeds")" asp-controller="GtfsFeeds" asp-action="Index"><i class="bi bi-file-earmark-zip"></i> Feeds GTFS</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Registos")" asp-controller="Registos" asp-action="Index"><i class="bi bi-journal-text"></i> Registos</a></li>
                            @if (isAdmin)
                            {
                                <li class="nav-item"><a class="nav-link @Active("Admin")" asp-controller="Admin" asp-action="Utilizadores"><i class="bi bi-people"></i> Utilizadores</a></li>
                            }
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle"></i> @User.Identity!.Name
                                    @if (isAdmin) { <span class="badge text-bg-warning ms-1">Admin</span> }
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="AlterarPassword">Alterar palavra-passe</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Terminar sessão</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="container-fluid px-4">
        <main role="main" class="pb-4">
            @if (TempData["Ok"] is string ok)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">@ok<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button></div>
            }
            @if (TempData["Erro"] is string erro)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">@erro<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button></div>
            }
            @RenderBody()
        </main>
    </div>
    <footer class="border-top text-muted small py-2 px-4">AppTIC &middot; Planeamento de circulações no TIC</footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <ejs-scripts></ejs-scripts>
</body>
</html>
