@model GtfsFeed
@{
    ViewData["Title"] = $"Feed {Model.Nome}";
    var registos = (List<RegistoRow>)ViewBag.Registos;
    var isAdmin = User.IsInRole(Roles.Admin);
}
<div class="page-header">
    <h1>@Model.Nome <span class="badge badge-estado-@Model.Estado fs-6 align-middle">@Model.Estado.DisplayName()</span></h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Download" asp-route-id="@Model.Id"><i class="bi bi-download"></i> Original</a>
        @if (Model.CaminhoFiltrado is not null)
        {
            <a class="btn btn-primary" asp-action="DownloadTic" asp-route-id="@Model.Id"><i class="bi bi-funnel"></i> GTFS filtrado TIC</a>
            @if (Model.OperadorId is not null && isAdmin)
            {
                <a class="btn btn-success" asp-action="Importar" asp-route-id="@Model.Id"><i class="bi bi-box-arrow-in-down"></i> Importar paragens e circulações</a>
            }
        }
        @if (isAdmin)
        {
            <form asp-action="Revalidar" asp-route-id="@Model.Id" method="post"><button class="btn btn-outline-secondary"><i class="bi bi-arrow-repeat"></i> Validar e filtrar de novo</button></form>
            <button type="button" class="btn btn-outline-danger" onclick="appTic.postConfirm('@Url.Action("Delete", new { id = Model.Id })', 'Eliminar este feed GTFS? O ficheiro será apagado.')"><i class="bi bi-trash"></i> Eliminar</button>
        }
        <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body row g-2 small">
        <div class="col-md-3"><span class="text-muted">Operador</span><br />@(Model.Operador?.Designacao ?? "–")</div>
        <div class="col-md-3"><span class="text-muted">Ficheiro</span><br />@Model.NomeFicheiroOriginal (@((Model.TamanhoBytes / 1024d / 1024d).ToString("N2")) MB)</div>
        <div class="col-md-3"><span class="text-muted">Carregado</span><br />@Model.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm") por @Model.Owner?.Email</div>
        <div class="col-md-3"><span class="text-muted">Validade do feed</span><br />@(Model.DataInicio?.ToString("dd/MM/yyyy") ?? "?") – @(Model.DataFim?.ToString("dd/MM/yyyy") ?? "?")</div>
        <div class="col-md-3"><span class="text-muted">Editor / versão</span><br />@Model.Editor @Model.Versao</div>
        <div class="col-md-12"><span class="text-muted">Conteúdo</span><br />
            @Model.NumAgencias agência(s) · @Model.NumParagens paragens · @Model.NumRotas rotas · @Model.NumViagens viagens · @Model.NumHorarios horários (stop_times)</div>
        @if (!string.IsNullOrWhiteSpace(Model.Descricao))
        {
            <div class="col-12"><span class="text-muted">Descrição</span><br />@Model.Descricao</div>
        }
        <div class="col-md-12 border-top pt-2"><span class="text-muted">Filtragem TIC</span><br />
            @if (Model.CaminhoFiltrado is not null)
            {
                <span><strong>@Model.NumViagensTic</strong> viagens passam no TIC · @Model.NumHorariosTic horários · @Model.NumRotasTic rotas · @Model.NumParagensTic paragens
                    (@(((Model.TamanhoFiltradoBytes ?? 0) / 1024d / 1024d).ToString("N2")) MB)</span>
            }
            else
            {
                <span>Não filtrado (ver registo).</span>
            }
            <br /><span class="text-muted">Paragens TIC usadas (stop_id):</span> <code>@Model.ParagensTic</code>
        </div>
        <div class="col-12 text-muted">SHA-256 <code>@Model.Sha256</code></div>
    </div>
</div>

@if (Model.Estado != GtfsFeedEstado.Invalido)
{
    <div class="card mb-3">
        <div class="card-header d-flex flex-wrap align-items-center gap-3 small">
            <strong><i class="bi bi-map"></i> Mapa</strong>
            <div class="btn-group btn-group-sm" role="group" aria-label="Feed a mostrar">
                @if (Model.CaminhoFiltrado is not null)
                {
                    <input type="radio" class="btn-check" name="mapaFonte" id="mapaTic" value="true" checked />
                    <label class="btn btn-outline-primary" for="mapaTic">Filtrado TIC</label>
                }
                <input type="radio" class="btn-check" name="mapaFonte" id="mapaOriginal" value="false" @(Model.CaminhoFiltrado is null ? "checked" : "") />
                <label class="btn btn-outline-primary" for="mapaOriginal">Original</label>
            </div>
            <div class="form-check form-check-inline m-0"><input class="form-check-input" type="checkbox" id="mapaShapes" checked /><label class="form-check-label" for="mapaShapes">Traçados</label></div>
            <div class="form-check form-check-inline m-0"><input class="form-check-input" type="checkbox" id="mapaStops" checked /><label class="form-check-label" for="mapaStops">Paragens</label></div>
            <span class="text-muted"><span class="mapa-legenda" style="background:#dc3545"></span> Paragem TIC</span>
            <span id="mapaEstado" class="text-muted ms-auto"></span>
        </div>
        <div class="position-relative">
            <div id="mapa" style="height: 520px"></div>
            <div id="mapaPopup" class="bg-body border rounded shadow-sm small px-2 py-1" style="position:absolute; pointer-events:none; display:none; z-index:10; white-space:nowrap"></div>
        </div>
    </div>
}

<h2 class="h5">Registo do feed</h2>
<partial name="_RegistosGrid" model="registos" />

@section Head {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@10.2.1/ol.css" />
    <style>
        .mapa-legenda { display: inline-block; width: 10px; height: 10px; border-radius: 50%; vertical-align: middle; }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/ol@10.2.1/dist/ol.js"></script>
    <script src="~/js/gtfs-mapa.js" asp-append-version="true"></script>
    <script>
        (function () {
            const el = document.getElementById('mapa');
            if (!el) return;
            const url = '@Url.Action("Mapa", new { id = Model.Id })';
            const estado = document.getElementById('mapaEstado');
            const mapa = gtfsMapa(el, document.getElementById('mapaPopup'));
            const camada = mapa.camada();
            const chkShapes = document.getElementById('mapaShapes');
            const chkStops = document.getElementById('mapaStops');

            async function carregar(tic) {
                estado.textContent = 'A carregar…';
                try {
                    const n = await camada.carregar(url + '?tic=' + tic);
                    estado.textContent = `${n.paragens} paragens · ${n.tracados} traçados`;
                    mapa.ajustar();
                } catch (e) {
                    estado.textContent = 'Erro ao carregar o mapa: ' + e.message;
                }
            }

            document.querySelectorAll('input[name="mapaFonte"]').forEach(r =>
                r.addEventListener('change', () => r.checked && carregar(r.value)));
            const visibilidade = () => camada.setVisible(chkShapes.checked, chkStops.checked);
            chkShapes.addEventListener('change', visibilidade);
            chkStops.addEventListener('change', visibilidade);

            carregar(document.querySelector('input[name="mapaFonte"]:checked').value);
        })();
    </script>
}

