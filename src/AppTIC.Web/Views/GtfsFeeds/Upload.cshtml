@model GtfsUploadViewModel
@{ ViewData["Title"] = "Carregar feed GTFS"; }
<div class="page-header"><h1>Carregar feed GTFS</h1></div>

<form asp-action="Upload" method="post" enctype="multipart/form-data" class="card card-form">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Nome" class="form-label"></label>
                <input asp-for="Nome" class="form-control" placeholder="ex.: Operador X – horário inverno 2027" />
                <span asp-validation-for="Nome" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Ficheiro" class="form-label"></label>
                <input asp-for="Ficheiro" type="file" accept=".zip,application/zip" class="form-control" />
                <span asp-validation-for="Ficheiro" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Descricao" class="form-label"></label>
                <textarea asp-for="Descricao" class="form-control" rows="2"></textarea>
            </div>
        </div>
        <p class="form-text mt-3 mb-0">O ficheiro é guardado e validado: ficheiros obrigatórios (agency, stops, routes, trips, stop_times, calendar/calendar_dates), contagens e datas de feed_info.txt. Cada passo fica no registo do feed.</p>
    </div>
    <div class="card-footer d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-upload"></i> Carregar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
