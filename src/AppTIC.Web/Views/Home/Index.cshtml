@{
    ViewData["Title"] = "Início";
    var alvaras = (List<(int Id, string Nome, DateOnly Data)>)ViewBag.AlvarasAExpirar;
    var autorizacoes = (List<(int Id, string Nome, DateOnly Data)>)ViewBag.AutorizacoesAExpirar;
    var feeds = (List<GtfsFeed>)ViewBag.UltimosFeeds;
    var hoje = DateOnly.FromDateTime(DateTime.Today);
    string Classe(DateOnly d) => d < hoje ? "text-danger fw-semibold" : "text-warning-emphasis";
    var isAdmin = User.IsInRole(Roles.Admin);
    var operador = User.FindFirst(AppClaims.OperadorNome)?.Value;
    var cartoes = new[] {
        ("Operadores", (int)ViewBag.NumOperadores, "building", "Operadores"),
        ("Paragens", (int)ViewBag.NumParagens, "geo-alt", "Paragens"),
        ("Circulações", (int)ViewBag.NumCirculacoes, "bus-front", "Circulacoes"),
        ("Pedidos pendentes", (int)ViewBag.NumPedidosPendentes, "pencil-square", "Pedidos"),
        ("Circulações hoje", (int)ViewBag.NumHoje, "calendar-day", "Calendario"),
        ("Feeds GTFS", (int)ViewBag.NumFeeds, "file-earmark-zip", "GtfsFeeds") }
        .Where(c => isAdmin || c.Item4 != "Operadores");
}
<div class="page-header">
    <h1>Início @(isAdmin ? "· todos os logins" : operador is not null ? $"· {operador}" : "")</h1>
</div>

@if (!isAdmin && operador is null)
{
    <div class="alert alert-warning">A sua conta ainda não está associada a nenhum operador. Contacte a gestão do TIC.</div>
}

<div class="row g-3 mb-4">
    @foreach (var (titulo, valor, icone, controller) in cartoes)
    {
        <div class="col-6 col-md-4 col-xl">
            <a class="card stat-card text-decoration-none h-100" asp-controller="@controller" asp-action="Index">
                <div class="card-body">
                    <div class="text-muted small"><i class="bi bi-@icone"></i> @titulo</div>
                    <div class="display-6">@valor</div>
                </div>
            </a>
        </div>
    }
</div>


@if (User.IsInRole(Roles.Admin))
{
    <div class="card mb-4">
        <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
            <span><i class="bi bi-bar-chart"></i> Ocupação do terminal <span class="text-muted small">(veículos que já chegaram e ainda não partiram, por 15 minutos)</span></span>
            <input type="date" class="form-control form-control-sm w-auto" id="ocupacaoDia" value="@hoje.ToString("yyyy-MM-dd")" aria-label="Dia" />
        </div>
        <div class="card-body">
            <div class="d-flex flex-wrap gap-4 small mb-2" id="ocupacaoResumo"></div>
            <div id="ocupacaoGrafico" style="height:320px"></div>
            <div class="form-text">Quando o TIC é início ou fim de viagem conta o tempo de embarque/desembarque da circulação (10 min se não estiver indicado).</div>
        </div>
    </div>
}
<div class="row g-3">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">Alvarás a expirar (60 dias)</div>
            <ul class="list-group list-group-flush">
                @foreach (var a in alvaras)
                {
                    <li class="list-group-item d-flex justify-content-between">@if (isAdmin) { <a asp-controller="Operadores" asp-action="Edit" asp-route-id="@a.Id">@a.Nome</a> } else { <span>@a.Nome</span> }<span class="@Classe(a.Data)">@a.Data.ToString("dd/MM/yyyy")</span></li>
                }
                @if (alvaras.Count == 0) { <li class="list-group-item text-muted small">Nenhum.</li> }
            </ul>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">Autorizações de serviço a expirar (60 dias)</div>
            <ul class="list-group list-group-flush">
                @foreach (var a in autorizacoes)
                {
                    <li class="list-group-item d-flex justify-content-between"><a asp-controller="Circulacoes" asp-action="Details" asp-route-id="@a.Id">@a.Nome</a><span class="@Classe(a.Data)">@a.Data.ToString("dd/MM/yyyy")</span></li>
                }
                @if (autorizacoes.Count == 0) { <li class="list-group-item text-muted small">Nenhuma.</li> }
            </ul>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between">Últimos feeds GTFS @if (isAdmin) { <a asp-controller="GtfsFeeds" asp-action="Upload" class="small">Carregar</a> }</div>
            <ul class="list-group list-group-flush">
                @foreach (var f in feeds)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <a asp-controller="GtfsFeeds" asp-action="Details" asp-route-id="@f.Id">@f.Nome</a>
                        <span class="badge badge-estado-@f.Estado">@f.Estado.DisplayName()</span>
                    </li>
                }
                @if (feeds.Count == 0) { <li class="list-group-item text-muted small">Nenhum feed carregado.</li> }
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    @if (User.IsInRole(Roles.Admin))
    {
        <script>
            (function () {
                ej.charts.Chart.Inject(ej.charts.ColumnSeries, ej.charts.Category, ej.charts.Tooltip);
                const diaInput = document.getElementById('ocupacaoDia');
                const resumo = document.getElementById('ocupacaoResumo');
                const cor = '#0d6efd', corAgora = '#084298';
                let dados = [];
                let atual = -1;

                const chart = new ej.charts.Chart({
                    primaryXAxis: { valueType: 'Category', interval: 4, labelIntersectAction: 'Hide', majorGridLines: { width: 0 }, majorTickLines: { width: 0 } },
                    primaryYAxis: { minimum: 0, labelFormat: 'n0', title: 'Veículos', lineStyle: { width: 0 }, majorTickLines: { width: 0 }, majorGridLines: { color: '#e9ecef' } },
                    chartArea: { border: { width: 0 } },
                    series: [{ type: 'Column', xName: 'Hora', yName: 'Veiculos', name: 'Veículos no terminal', fill: cor,
                               columnWidth: 0.85, cornerRadius: { topLeft: 3, topRight: 3 }, dataSource: [] }],
                    tooltip: { enable: true },
                    tooltipRender: function (args) {
                        const d = dados[args.point.index];
                        const fim = dados[args.point.index + 1]?.Hora ?? '24:00';
                        args.text = `${d.Hora}–${fim}<br/><b>${d.Veiculos}</b> veículo(s) no terminal<br/>${d.Chegadas} chegada(s) · ${d.Partidas} partida(s)`;
                    },
                    pointRender: function (args) { if (args.point.index === atual) args.fill = corAgora; },
                    legendSettings: { visible: false },
                    height: '320px'
                }, '#ocupacaoGrafico');

                async function carregar() {
                    const dia = diaInput.value;
                    const r = await fetch(`@Url.Action("Ocupacao")?dia=${dia}`);
                    if (!r.ok) { resumo.textContent = 'Erro ao carregar a ocupação.'; return; }
                    dados = await r.json();
                    const agora = new Date();
                    const hojeIso = `${agora.getFullYear()}-${String(agora.getMonth() + 1).padStart(2, '0')}-${String(agora.getDate()).padStart(2, '0')}`;
                    atual = dia === hojeIso ? Math.floor((agora.getHours() * 60 + agora.getMinutes()) / 15) : -1;

                    const pico = dados.reduce((m, d) => d.Veiculos > m.Veiculos ? d : m, dados[0]);
                    const soma = k => dados.reduce((s, d) => s + d[k], 0);
                    const item = (rotulo, valor) => `<div><span class="text-muted">${rotulo}</span><br/><span class="fs-5 fw-semibold">${valor}</span></div>`;
                    resumo.innerHTML = (atual >= 0 ? item('Agora', `${dados[atual].Veiculos} veículo(s)`) : '')
                        + item('Pico', pico.Veiculos > 0 ? `${pico.Veiculos} às ${pico.Hora}` : '–')
                        + item('Chegadas', soma('Chegadas')) + item('Partidas', soma('Partidas'));
                    chart.series[0].dataSource = dados;
                    chart.refresh();
                }

                diaInput.addEventListener('change', carregar);
                carregar();
            })();
        </script>
    }
}
