@model Operador
@inject Microsoft.Extensions.Options.IOptions<GtfsOptions> GtfsOpts
@{
    ViewData["Title"] = Model.Id == 0 ? "Novo operador" : "Editar operador";
    var ambitos = EnumExtensions.ToLookup<Ambito>();
    var grupos = (List<LookupItem>)ViewBag.Grupos;
    var membros = (List<string>)ViewBag.Membros;
}
<div class="page-header"><h1>@ViewData["Title"]</h1></div>

<form asp-action="Save" method="post" class="card card-form">
    <div class="card-body">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Nif" class="form-label"></label>
                <input asp-for="Nif" class="form-control" placeholder="5…" />
                <span asp-validation-for="Nif" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Designacao" class="form-label"></label>
                <input asp-for="Designacao" class="form-control" placeholder="designação completa" />
                <span asp-validation-for="Designacao" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Abreviatura" class="form-label"></label>
                <input asp-for="Abreviatura" class="form-control" />
            </div>
            <div class="col-md-6">
                <partial name="_CorPicker" model="@(new CorPickerModel(Model.Cor, (string)ViewBag.CorEfetiva,
                    Model.GrupoId is null ? "Sem cor própria (cor por omissão)" : "Sem cor própria (usa a cor do grupo)"))" />
            </div>
            <div class="col-md-4">
                <label asp-for="Alvara" class="form-label"></label>
                <input asp-for="Alvara" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="AlvaraValidade" class="form-label"></label>
                <ejs-datepicker id="AlvaraValidade" name="AlvaraValidade" value="@Model.AlvaraValidade.ToDateTime()" format="dd/MM/yyyy" placeholder="dd/mm/aaaa"></ejs-datepicker>
                <span asp-validation-for="AlvaraValidade" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Ambito" class="form-label"></label>
                <ejs-dropdownlist id="Ambito" name="Ambito" dataSource="@ambitos" value="@Model.Ambito?.ToString()" placeholder="Escolha…" showClearButton="true">
                    <e-dropdownlist-fields text="Text" value="Value"></e-dropdownlist-fields>
                </ejs-dropdownlist>
            </div>
            <div class="col-12"><h2 class="h6 text-uppercase text-muted mt-2 mb-0">Grupo e numeração do ID TIC</h2></div>
            @if (Model.EGrupo)
            {
                <div class="col-md-8">
                    <label class="form-label">Grupo</label>
                    <div class="form-control-plaintext"><span class="badge text-bg-info">é um grupo</span>
                        <a asp-controller="Grupos" asp-action="Edit" asp-route-id="@Model.Id" class="ms-2">gerir os operadores do grupo</a></div>
                </div>
            }
            else
            {
                <div class="col-md-8">
                    <label asp-for="GrupoId" class="form-label">Pertence ao grupo</label>
                    <ejs-dropdownlist id="GrupoId" name="GrupoId" dataSource="@grupos" value="@Model.GrupoId?.ToString()" placeholder="Sem grupo" showClearButton="true">
                        <e-dropdownlist-fields text="Text" value="Value"></e-dropdownlist-fields>
                    </ejs-dropdownlist>
                    <span asp-validation-for="GrupoId" class="text-danger small"></span>
                </div>
            }
            <div class="col-md-4">
                <label asp-for="PrefixoIdTic" class="form-label"></label>
                <input asp-for="PrefixoIdTic" type="number" min="1" max="999" class="form-control" placeholder="ex.: 8 → 8001, 8002…" />
                <span asp-validation-for="PrefixoIdTic" class="text-danger small"></span>
            </div>
            <div class="col-12 form-text mt-0">
                Os grupos gerem-se em <a asp-controller="Grupos" asp-action="Index">Grupos</a>. Num operador do grupo vale o prefixo do ID TIC do grupo.
                @if (membros.Count > 0) { <br /><strong>Operadores do grupo:</strong> @string.Join(", ", membros) }
            </div>
            <div class="col-12">
                <label asp-for="GtfsParagensTic" class="form-label"></label>
                <input asp-for="GtfsParagensTic" class="form-control font-monospace" placeholder="ex.: 100" />
                <div class="form-text">
                    stop_id da paragem do TIC no GTFS deste operador (vários separados por vírgula). Os feeds GTFS do operador são filtrados
                    pelas viagens que passam nestas paragens. Vazio = usa a lista por omissão:
                    <code>@string.Join(", ", GtfsOpts.Value.ParagensTicPorOmissao)</code>
                </div>
            </div>
            <div class="col-12">
                <label asp-for="Comentarios" class="form-label"></label>
                <textarea asp-for="Comentarios" class="form-control" rows="3"></textarea>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
